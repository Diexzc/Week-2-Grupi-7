import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Mini Quiz App',
      home: const QuizScreen(),
    );
  }
}

// ----- MODELI ------
class Question {
  final String text;
  final List<String> options;
  final int correctIndex; // indeksi i përgjigjes së saktë në options

  Question({
    required this.text,
    required this.options,
    required this.correctIndex,
  });
}

// Lista e pyetjeve - mund t'i ndryshoni/shtoni sipas dëshirës
List<Question> sampleQuestions = [
  Question(
    text: "Sa është 2 + 2?",
    options: ["3", "4", "5"],
    correctIndex: 1,
  ),
  Question(
    text: "Cili është kryeqyteti i Kosovës?",
    options: ["Prishtinë", "Tiranë", "Shkup"],
    correctIndex: 0,
  ),
  Question(
    text: "Sa kontinente ka Toka?",
    options: ["5", "6", "7"],
    correctIndex: 2,
  ),
];

// ----- EKRANI KRYESOR ------
class QuizScreen extends StatefulWidget {
  const QuizScreen({super.key});

  @override
  State<QuizScreen> createState() => _QuizScreenState();
}

class _QuizScreenState extends State<QuizScreen> {
  int currentIndex = 0;
  int score = 0;

  void answerQuestion(int selectedIndex) {
    final question = sampleQuestions[currentIndex];
    final isCorrect = selectedIndex == question.correctIndex;
    final isLastQuestion = currentIndex == sampleQuestions.length - 1;

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(isCorrect ? 'Përgjigje e saktë!' : 'Përgjigje e gabuar.'),
        duration: const Duration(milliseconds: 600),
      ),
    );

    setState(() {
      if (isCorrect) score++;
      if (!isLastQuestion) currentIndex++;
    });

    if (isLastQuestion) {
      Navigator.push(
        context,
        MaterialPageRoute(
          builder: (_) => ResultScreen(
            score: score,
            total: sampleQuestions.length,
            onRestart: restartQuiz,
          ),
        ),
      );
    }
  }

  void restartQuiz() {
    setState(() {
      currentIndex = 0;
      score = 0;
    });
    Navigator.pop(context);
  }

  void confirmExit() {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Dilni nga kuizi?'),
        content: const Text('Përparimi juaj aktual do të humbet.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Anulo'),
          ),
          TextButton(
            onPressed: () {
              Navigator.pop(context);
              setState(() {
                currentIndex = 0;
                score = 0;
              });
            },
            child: const Text('Dil dhe rifillo'),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final question = sampleQuestions[currentIndex];

    return Scaffold(
      appBar: AppBar(
        title: Text('Pyetja ${currentIndex + 1}/${sampleQuestions.length}'),
        actions: [
          IconButton(icon: const Icon(Icons.close), onPressed: confirmExit),
        ],
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              question.text,
              style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 24),
            ...List.generate(question.options.length, (i) {
              return Padding(
                padding: const EdgeInsets.symmetric(vertical: 6.0),
                child: SizedBox(
                  width: double.infinity,
                  child: ElevatedButton(
                    onPressed: () => answerQuestion(i),
                    child: Text(question.options[i]),
                  ),
                ),
              );
            }),
          ],
        ),
      ),
    );
  }
}

// ----- EKRANI I REZULTATIT ------
class ResultScreen extends StatelessWidget {
  final int score;
  final int total;
  final VoidCallback onRestart;

  const ResultScreen({
    super.key,
    required this.score,
    required this.total,
    required this.onRestart,
  });

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Rezultati')),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text(
              '$score / $total',
              style: const TextStyle(fontSize: 40, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 16),
            const Text('Përgjigje të sakta'),
            const SizedBox(height: 32),
            ElevatedButton(
              onPressed: onRestart,
              child: const Text('Rifillo (Restart)'),
            ),
          ],
        ),
      ),
    );
  }
}
